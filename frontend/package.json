{
  "name": "castor-local",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "start": "node scripts/local.mjs start",
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "cheerio": "1.2.0",
    "undici": "8.11.2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "@playwright/test": "1.64.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
